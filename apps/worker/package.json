{
  "name": "@omnicus/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-output.mjs apps/worker/dist && tsc -p tsconfig.build.json",
    "contact-merge-backfill": "tsx src/crm/contact-merge-backfill.cli.ts",
    "contact-merge-backfill:prod": "node dist/crm/contact-merge-backfill.cli.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "vitest run src/queue/demo-queue.integration.test.ts src/telegram-inbound/telegram-inbound.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@omnicus/automation-core": "workspace:*",
    "@omnicus/automation-http": "workspace:*",
    "@nestjs/platform-express": "11.1.28",
    "@omnicus/channel-secrets": "workspace:*",
    "@omnicus/channel-telegram": "workspace:*",
    "@omnicus/channel-whatsapp": "workspace:*",
    "@omnicus/crm-core": "workspace:*",
    "@omnicus/config": "workspace:*",
    "@omnicus/contracts": "workspace:*",
    "@omnicus/database": "workspace:*",
    "@omnicus/email-core": "workspace:*",
    "@omnicus/media-core": "workspace:*",
    "bullmq": "5.81.1",
    "reflect-metadata": "0.2.2",
    "resend": "6.12.4",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@omnicus/test-fixtures": "workspace:*",
    "@types/express": "5.0.6"
  }
}
