{
  "name": "@omnicus/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-output.mjs apps/api/dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'",
    "test:integration": "node ../../scripts/run-jest-integration.mjs --config jest.config.cjs --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@omnicus/automation-core": "workspace:*",
    "@omnicus/automation-http": "workspace:*",
    "@omnicus/channel-secrets": "workspace:*",
    "@omnicus/channel-telegram": "workspace:*",
    "@omnicus/channel-whatsapp": "workspace:*",
    "@omnicus/config": "workspace:*",
    "@omnicus/contracts": "workspace:*",
    "@omnicus/database": "workspace:*",
    "@omnicus/email-core": "workspace:*",
    "@omnicus/media-core": "workspace:*",
    "@omnicus/shared": "workspace:*",
    "argon2": "0.44.0",
    "bullmq": "5.81.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "resend": "6.12.4",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
