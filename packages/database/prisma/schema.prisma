  channelIdentity   ChannelIdentity        @relation(fields: [projectId, channelIdentityId], references: [projectId, id], onDelete: Restrict)
  message           Message                @relation(fields: [projectId, messageId], references: [projectId, id], onDelete: Restrict)
  outboxRecord      OutboxRecord           @relation(fields: [projectId, outboxRecordId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, messageId])
  @@unique([projectId, outboxRecordId])
  @@unique([projectId, seriesId, occurrence])
  @@index([projectId, status, scheduledAt])
  @@index([projectId, connectionId, status])
  @@map("scheduled_messages")
}

model TelegramMediaGroup {
  id                  String                   @id @default(uuid())
  projectId           String
  connectionId        String
  contactId           String
  channelIdentityId   String
  outboxRecordId      String                   @unique
  status              TelegramMediaGroupStatus @default(QUEUED)
  disableNotification Boolean                  @default(false)
  protectContent      Boolean                  @default(false)
  providerMessageIds  Json?
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?                @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  connection          ChannelConnection        @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  contact             Contact                  @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Restrict)
  channelIdentity     ChannelIdentity          @relation(fields: [projectId, channelIdentityId], references: [projectId, id], onDelete: Restrict)
  outboxRecord        OutboxRecord             @relation(fields: [projectId, outboxRecordId], references: [projectId, id], onDelete: Restrict)
  items               TelegramMediaGroupItem[]

  @@unique([projectId, id])
  @@unique([projectId, outboxRecordId])
  @@index([projectId, connectionId, status])
  @@map("telegram_media_groups")
}

model TelegramMediaGroupItem {
  id                String              @id @default(uuid())
  projectId         String
  mediaGroupId      String
  mediaAssetId      String
  position          Int
  kind              MessageTemplateKind
  caption           String?
  entities          Json?
  hasSpoiler        Boolean             @default(false)
  providerMessageId String?
  mediaGroup        TelegramMediaGroup  @relation(fields: [projectId, mediaGroupId], references: [projectId, id], onDelete: Restrict)
  mediaAsset        MediaAsset          @relation(fields: [projectId, mediaAssetId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, mediaGroupId, position])
  @@index([projectId, mediaAssetId])
  @@map("telegram_media_group_items")
}

model TelegramBotInterface {
  id             String            @id @default(uuid())
  projectId      String
  connectionId   String
  outboxRecordId String?           @unique
  commands       Json              @default("[]")
  commandScope   Json              @default("{\"type\":\"default\"}")
  languageCode   String            @default("")
  menuButton     Json              @default("{\"type\":\"default\"}")
  revision       Int               @default(0)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  connection     ChannelConnection @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  outboxRecord   OutboxRecord?     @relation(fields: [projectId, outboxRecordId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, connectionId])
  @@unique([projectId, outboxRecordId])
  @@map("telegram_bot_interfaces")
}

model CrmProjectConfig {
  id                   String              @id @default(uuid())
  projectId            String              @unique
  provider             CrmProvider         @default(CYBER_PULSE)
  status               CrmConnectionStatus @default(DRAFT)
  crmProjectId         String
  baseUrl              String?
  credentialsEncrypted Json?
  inboundTokenHash     String?             @unique
  pairingCodeHash      String?             @unique
  pairingExpiresAt     DateTime?           @db.Timestamptz(3)
  capabilities         Json                @default("{}")
  fieldMapping         Json                @default("{}")
  defaultPipeline      String?
  defaultStage         String?
  additionalParameters Json                @default("{}")
  enabled              Boolean             @default(true)
  lastTestedAt         DateTime?           @db.Timestamptz(3)
  lastErrorAt          DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, crmProjectId])
  @@unique([provider, crmProjectId])
  @@index([status, pairingExpiresAt])
  @@map("crm_project_configs")
}

model CrmOperation {
  id                String           @id @default(uuid())
  projectId         String
  outboxRecordId    String           @unique
  contactId         String?
  normalizedEventId String?
  messageId         String?          @unique
  type              CrmOperationType
  inputSafe         Json
  resultSafe        Json?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  outbox            OutboxRecord     @relation(fields: [projectId, outboxRecordId], references: [projectId, id], onDelete: Restrict)
  contact           Contact?         @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Restrict)
  normalizedEvent   NormalizedEvent? @relation(fields: [projectId, normalizedEventId], references: [projectId, id], onDelete: Restrict)
  message           Message?         @relation(fields: [projectId, messageId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, outboxRecordId])
  @@index([projectId, contactId])
  @@index([projectId, normalizedEventId])
  @@index([projectId, messageId])
  @@map("crm_operations")
}

model IdempotencyRecord {
  id         String    @id @default(uuid())
  projectId  String
  scope      String
  key        String
  resultSafe Json?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)

  @@unique([projectId, scope, key])
  @@index([projectId, expiresAt])
  @@map("idempotency_records")
}

model Tag {
  id             String       @id @default(uuid())
  projectId      String
  name           String
  normalizedName String
  color          String?
  description    String?
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contacts       ContactTag[]

  @@unique([projectId, id])
  @@unique([projectId, normalizedName])
  @@index([projectId, archivedAt])
  @@map("tags")
}

model ContactTag {
  projectId String
  contactId String
  tagId     String
  source    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  contact   Contact  @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Cascade)
  tag       Tag      @relation(fields: [projectId, tagId], references: [projectId, id], onDelete: Restrict)

  @@id([projectId, contactId, tagId])
  @@index([projectId, tagId, contactId])
  @@map("contact_tags")
}

model CustomFieldDefinition {
  id          String                    @id @default(uuid())
  projectId   String
  key         String
  name        String
  description String?
  type        CustomFieldType
  options     Json?
  archivedAt  DateTime?                 @db.Timestamptz(3)
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  values      ContactCustomFieldValue[]

  @@unique([projectId, id])
  @@unique([projectId, key])
  @@index([projectId, archivedAt])
  @@map("custom_field_definitions")
}

model ContactCustomFieldValue {
  id            String                @id @default(uuid())
  projectId     String
  contactId     String
  definitionId  String
  valueJson     Json
  valueText     String?
  valueNumber   Decimal?              @db.Decimal(30, 10)
  valueBoolean  Boolean?
  valueDateTime DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contact       Contact               @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Cascade)
  definition    CustomFieldDefinition @relation(fields: [projectId, definitionId], references: [projectId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, contactId, definitionId])
  @@index([projectId, definitionId, valueText])
  @@index([projectId, definitionId, valueNumber])
  @@index([projectId, definitionId, valueDateTime])
  @@map("contact_custom_field_values")
}

model Segment {
  id                  String        @id @default(uuid())
  projectId           String
  name                String
  filterSchemaVersion Int           @default(1)
  filter              Json
  status              SegmentStatus @default(ACTIVE)
  archivedAt          DateTime?     @db.Timestamptz(3)
  createdById         String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy           User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, id])
  @@unique([projectId, name])
  @@index([projectId, status, updatedAt])
  @@map("segments")
}

model AuditLog {
  id                  String   @id @default(uuid())
  projectId           String?
  projectNameSnapshot String?
  projectSlugSnapshot String?
  actorUserId         String?
  actorEmailSnapshot  String?
  actorType           String
  action              String
  entityType          String
  entityId            String?
  beforeSafeJson      Json?
  afterSafeJson       Json?
  ip                  String?
  userAgent           String?
  correlationId       String
  reason              String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  purgeAfter          DateTime @db.Timestamptz(3)
  project             Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor               User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@index([purgeAfter])
  @@map("audit_logs")
}
