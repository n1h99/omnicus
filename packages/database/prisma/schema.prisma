generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  REUSED
  EXPIRED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  BLOCKED
  UNSUBSCRIBED
  ARCHIVED
  MERGED
}

enum SegmentStatus {
  ACTIVE
  ARCHIVED
}

enum AutomationMode {
  ENABLED
  DISABLED
}

enum ChannelType {
  TELEGRAM
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTI_SELECT
  JSON
}

enum ChannelConnectionStatus {
  DRAFT
  ACTIVE
  DISABLED
  ERROR
}

enum RawWebhookEventStatus {
  RECEIVED
  EXPIRED
}

enum InboxRecordStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRY
  FAILED
  DEAD_LETTER
}

enum OutboxRecordStatus {
  PENDING
  PROCESSING
  RETRY
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum OutboxKind {
  TELEGRAM
  WHATSAPP
  CRM
  HTTP
}

enum CrmOperationType {
  CREATE_OR_UPDATE_LEAD
  MERGE_CONTACTS
  FORWARD_INBOUND_MESSAGE
  FORWARD_OUTBOUND_MESSAGE
  FORWARD_REACTION_EVENT
  FORWARD_MESSAGE_EDIT
  FORWARD_CONTACT_SHARE
  FORWARD_AUTOMATION_STATE
  FORWARD_MESSAGE_STATUS
  FORWARD_TRACKED_LINK_CLICK
}

enum CrmProvider {
  CYBER_PULSE
}

enum CrmConnectionStatus {
  DRAFT
  PAIRING
  ACTIVE
  DISABLED
  ERROR
}

enum NormalizedEventType {
  MESSAGE
  COMMAND
  PHOTO
  DOCUMENT
  VIDEO
  AUDIO
  VOICE
  VIDEO_NOTE
  ANIMATION
  STICKER
  CALLBACK_QUERY
  REACTION
  MESSAGE_EDITED
  CONTACT_SHARED
  AUTOMATION_STATE
  INTERACTIVE
  MESSAGE_STATUS
  CHAT_MEMBER
  UNSUPPORTED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum ConversationAutomationState {
  AUTO
  MANUAL
  PAUSED
}

enum ChannelIdentityStatus {
  ACTIVE
  BLOCKED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  COMMAND
  PHOTO
  DOCUMENT
  VIDEO
  AUDIO
  VOICE
  VIDEO_NOTE
  ANIMATION
  STICKER
  CONTACT
  LOCATION
  POLL
  RICH
  INTERACTIVE
  CALLBACK_QUERY
  SYSTEM
  UNSUPPORTED
}

enum ScheduledMessageStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  UNKNOWN
  CANCELLED
}

enum TelegramMediaGroupStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  UNKNOWN
}

enum MessageStatus {
  QUEUED
  RECEIVED
  PROCESSING
  SENT
  DELIVERED
  READ
  DELETED
  FAILED
  UNKNOWN
}

enum MediaAssetSource {
  USER_UPLOAD
  TELEGRAM
  WHATSAPP
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
  UNKNOWN
}

enum WhatsAppTemplateCategory {
  AUTHENTICATION
  MARKETING
  UTILITY
  UNKNOWN
}

enum WhatsAppTemplateQuality {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum MediaAssetStatus {
  PROVIDER_REFERENCE
  PENDING_UPLOAD
  AVAILABLE
  REJECTED
  UNAVAILABLE
  DELETED
}

enum MessageTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageTemplateVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum MessageTemplateKind {
  TEXT
  PHOTO
  DOCUMENT
  VIDEO
  AUDIO
  VOICE
  VIDEO_NOTE
  ANIMATION
  STICKER
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PREPARING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
  ARCHIVED
}

enum BroadcastRecipientStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
  CANCELLED
  UNKNOWN
}

enum ScenarioStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ScenarioVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum ScenarioExecutionStatus {
  QUEUED
  RUNNING
  WAITING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum NodeExecutionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum WaitStateStatus {
  ACTIVE
  RESOLVED
  TIMED_OUT
  CANCELLED
}

enum DelayedActionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String
  normalizedEmail         String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  country                 String?
  region                  String?
  city                    String?
  status                  UserStatus               @default(ACTIVE)
  lastLoginAt             DateTime?                @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  globalRoles             GlobalUserRole[]         @relation("GlobalUserRoleUser")
  globalRolesCreated      GlobalUserRole[]         @relation("GlobalUserRoleCreatedBy")
  memberships             ProjectMembership[]      @relation("ProjectMembershipUser")
  membershipsCreated      ProjectMembership[]      @relation("ProjectMembershipCreatedBy")
  globalInvitesSent       GlobalUserInviteToken[]  @relation("GlobalInviteInvitedBy")
  projectInvitesSent      ProjectUserInviteToken[] @relation("ProjectInviteInvitedBy")
  auditLogs               AuditLog[]               @relation("AuditActor")
  segmentsCreated         Segment[]
  broadcastsCreated       Broadcast[]
  messageTemplatesCreated MessageTemplate[]

  @@map("users")
}

model Session {
  id                  String      @id @default(uuid())
  userId              String
  tokenFamilyId       String
  refreshTokenHash    String      @unique
  csrfTokenHash       String
  status              TokenStatus @default(ACTIVE)
  replacedBySessionId String?
  issuedAt            DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt           DateTime    @db.Timestamptz(3)
  rotatedAt           DateTime?   @db.Timestamptz(3)
  revokedAt           DateTime?   @db.Timestamptz(3)
  reuseDetectedAt     DateTime?   @db.Timestamptz(3)
  ip                  String?
  userAgent           String?
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBySession   Session?    @relation("SessionRotation", fields: [replacedBySessionId, userId, tokenFamilyId], references: [id, userId, tokenFamilyId], onDelete: Restrict)
  replacesSession     Session?    @relation("SessionRotation")

  @@unique([id, userId, tokenFamilyId])
  @@unique([replacedBySessionId, userId, tokenFamilyId])
  @@index([userId, status])
  @@index([tokenFamilyId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  ip        String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Permission {
  id           String                  @id @default(uuid())
  code         String                  @unique
  description  String
  globalRoles  GlobalRolePermission[]
  projectRoles ProjectRolePermission[]

  @@map("permissions")
}

model GlobalRole {
  id                       String                          @id @default(uuid())
  name                     String
  normalizedName           String                          @unique
  system                   Boolean                         @default(false)
  createdAt                DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                        @updatedAt @db.Timestamptz(3)
  permissions              GlobalRolePermission[]
  userRoles                GlobalUserRole[]
  inviteTokens             GlobalUserInviteToken[]
  activeInviteReservations GlobalActiveInviteReservation[]

  @@map("global_roles")
}

model ProjectRole {
  id             String                   @id @default(uuid())
  projectId      String
  name           String
  normalizedName String
  system         Boolean                  @default(false)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  permissions    ProjectRolePermission[]
  memberships    ProjectMembership[]
  inviteTokens   ProjectUserInviteToken[]

  @@unique([projectId, id])
  @@unique([projectId, normalizedName])
  @@map("project_roles")
}

model GlobalRolePermission {
  globalRoleId String
  permissionId String
  globalRole   GlobalRole @relation(fields: [globalRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([globalRoleId, permissionId])
  @@index([permissionId])
  @@map("global_role_permissions")
}

model ProjectRolePermission {
  projectId     String
  projectRoleId String
  permissionId  String
  projectRole   ProjectRole @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([projectId, projectRoleId, permissionId])
  @@index([permissionId])
  @@map("project_role_permissions")
}

model GlobalUserRole {
  id           String     @id @default(uuid())
  userId       String
  globalRoleId String
  createdById  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation("GlobalUserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  globalRole   GlobalRole @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  createdBy    User?      @relation("GlobalUserRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, globalRoleId])
  @@index([globalRoleId])
  @@index([createdById])
  @@map("global_user_roles")
}

model ProjectMembership {
  id            String           @id @default(uuid())
  projectId     String
  userId        String
  projectRoleId String
  createdById   String?
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user          User             @relation("ProjectMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  projectRole   ProjectRole      @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Restrict)
  createdBy     User?            @relation("ProjectMembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, id])
  @@unique([projectId, userId])
  @@index([projectId, projectRoleId])
  @@index([userId, status])
  @@index([createdById])
  @@map("project_memberships")
}

model GlobalUserInviteToken {
  id                     String                         @id @default(uuid())
  normalizedEmail        String
  emailSnapshot          String
  globalRoleId           String
  tokenHash              String                         @unique
  invitedById            String?
  invitedByEmailSnapshot String
  expiresAt              DateTime                       @db.Timestamptz(3)
  acceptedAt             DateTime?                      @db.Timestamptz(3)
  revokedAt              DateTime?                      @db.Timestamptz(3)
  createdAt              DateTime                       @default(now()) @db.Timestamptz(3)
  globalRole             GlobalRole                     @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  invitedBy              User?                          @relation("GlobalInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  activeReservation      GlobalActiveInviteReservation?

  @@unique([id, globalRoleId])
  @@index([normalizedEmail, expiresAt])
  @@index([globalRoleId])
  @@index([invitedById])
  @@map("global_user_invite_tokens")
}

model GlobalActiveInviteReservation {
  normalizedEmail String
  globalRoleId    String
  inviteTokenId   String                @unique
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  globalRole      GlobalRole            @relation(fields: [globalRoleId], references: [id], onDelete: Restrict)
  inviteToken     GlobalUserInviteToken @relation(fields: [inviteTokenId, globalRoleId], references: [id, globalRoleId], onDelete: Cascade)

  @@id([normalizedEmail, globalRoleId])
  @@unique([inviteTokenId, globalRoleId])
  @@index([globalRoleId])
  @@map("global_active_invite_reservations")
}

model ProjectUserInviteToken {
  id                     String                          @id @default(uuid())
  projectId              String
  projectRoleId          String
  normalizedEmail        String
  emailSnapshot          String
  tokenHash              String                          @unique
  invitedById            String?
  invitedByEmailSnapshot String
  expiresAt              DateTime                        @db.Timestamptz(3)
  acceptedAt             DateTime?                       @db.Timestamptz(3)
  revokedAt              DateTime?                       @db.Timestamptz(3)
  createdAt              DateTime                        @default(now()) @db.Timestamptz(3)
  project                Project                         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectRole            ProjectRole                     @relation(fields: [projectId, projectRoleId], references: [projectId, id], onDelete: Restrict)
  invitedBy              User?                           @relation("ProjectInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  activeReservation      ProjectActiveInviteReservation?

  @@unique([projectId, id])
  @@index([projectId, normalizedEmail, expiresAt])
  @@index([projectId, projectRoleId])
  @@index([invitedById])
  @@map("project_user_invite_tokens")
}

model ProjectActiveInviteReservation {
  projectId       String
  normalizedEmail String
  inviteTokenId   String                 @unique
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  inviteToken     ProjectUserInviteToken @relation(fields: [projectId, inviteTokenId], references: [projectId, id], onDelete: Cascade)

  @@id([projectId, normalizedEmail])
  @@unique([projectId, inviteTokenId])
  @@map("project_active_invite_reservations")
}

model Project {
  id                       String                           @id @default(uuid())
  name                     String
  slug                     String                           @unique
  description              String?
  status                   ProjectStatus                    @default(DRAFT)
  timezone                 String
  locale                   String
  settings                 Json
  version                  Int                              @default(1)
  createdAt                DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                         @updatedAt @db.Timestamptz(3)
  roles                    ProjectRole[]
  memberships              ProjectMembership[]
  inviteTokens             ProjectUserInviteToken[]
  activeInviteReservations ProjectActiveInviteReservation[]
  auditLogs                AuditLog[]
  contacts                 Contact[]
  tags                     Tag[]
  customFieldDefinitions   CustomFieldDefinition[]
  customFieldValues        ContactCustomFieldValue[]
  segments                 Segment[]
  mediaAssets              MediaAsset[]
  messageTemplates         MessageTemplate[]
  messageTemplateVersions  MessageTemplateVersion[]
  channelConnections       ChannelConnection[]
  scenarios                Scenario[]
  scenarioExecutions       ScenarioExecution[]
  waitStates               WaitState[]
  delayedActions           DelayedAction[]
  automationSecrets        AutomationSecret[]
  externalHttpOperations   ExternalHttpOperation[]
  crmConfig                CrmProjectConfig?
  crmOperations            CrmOperation[]
  broadcasts               Broadcast[]
  broadcastRecipients      BroadcastRecipient[]
  scheduledMessages        ScheduledMessage[]
  telegramMediaGroups      TelegramMediaGroup[]
  telegramBotInterfaces    TelegramBotInterface[]
  messageStatusEvents      MessageStatusEvent[]
  whatsAppMessageTemplates WhatsAppMessageTemplate[]

  @@index([status, createdAt])
  @@map("projects")
}

model Contact {
  id                  String                    @id @default(uuid())
  projectId           String
  displayName         String
  firstName           String?
  lastName            String?
  username            String?
  phone               String?
  email               String?
  normalizedPhone     String?
  normalizedEmail     String?
  status              ContactStatus             @default(ACTIVE)
  automationMode      AutomationMode            @default(ENABLED)
  crmLeadId           String?
  crmContactId        String?
  crmManagerId        String?
  customFields        Json                      @default("{}")
  firstInteractionAt  DateTime?                 @db.Timestamptz(3)
  lastInteractionAt   DateTime?                 @db.Timestamptz(3)
  archivedAt          DateTime?                 @db.Timestamptz(3)
  mergedIntoContactId String?
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  channelIdentities   ChannelIdentity[]
  tags                ContactTag[]
  conversations       Conversation[]
  messages            Message[]
  scenarioExecutions  ScenarioExecution[]
  crmOperations       CrmOperation[]
  customFieldValues   ContactCustomFieldValue[]
  broadcastRecipients BroadcastRecipient[]
  scheduledMessages   ScheduledMessage[]
  telegramMediaGroups TelegramMediaGroup[]
  mergedInto          Contact?                  @relation("ContactMerge", fields: [projectId, mergedIntoContactId], references: [projectId, id], onDelete: Restrict)
  mergedContacts      Contact[]                 @relation("ContactMerge")

  @@unique([projectId, id])
  @@index([projectId, status, createdAt])
  @@index([projectId, lastInteractionAt])
  @@index([projectId, displayName])
  @@index([projectId, crmLeadId])
  @@index([projectId, mergedIntoContactId])
  @@index([projectId, normalizedPhone])
  @@index([projectId, normalizedEmail])
  @@map("contacts")
}

model ChannelIdentity {
  id                  String                @id @default(uuid())
  projectId           String
  contactId           String
  connectionId        String
  channel             ChannelType
  externalUserId      String
  username            String?
  displayName         String?
  languageCode        String?
  status              ChannelIdentityStatus @default(ACTIVE)
  metadata            Json?
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  contact             Contact               @relation(fields: [projectId, contactId], references: [projectId, id], onDelete: Cascade)
  connection          ChannelConnection     @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  broadcastRecipients BroadcastRecipient[]
  scheduledMessages   ScheduledMessage[]
  telegramMediaGroups TelegramMediaGroup[]

  @@unique([projectId, id])
  @@unique([projectId, connectionId, externalUserId])
  @@index([projectId, contactId])
  @@map("channel_identities")
}

model ChannelConnection {
  id                     String                    @id @default(uuid())
  projectId              String
  type                   ChannelType               @default(TELEGRAM)
  status                 ChannelConnectionStatus   @default(DRAFT)
  credentialsEncrypted   Json
  webhookSecretEncrypted Json?
  botUsername            String?
  externalBotId          String?
  providerAccountId      String?
  providerIdentityId     String?
  webhookMetadata        Json?
  lastWebhookAt          DateTime?                 @db.Timestamptz(3)
  lastErrorAt            DateTime?                 @db.Timestamptz(3)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(3)
  project                Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  identities             ChannelIdentity[]
  rawWebhookEvents       RawWebhookEvent[]
  inboxRecords           InboxRecord[]
  normalizedEvents       NormalizedEvent[]
  conversations          Conversation[]
  messages               Message[]
  outboxRecords          OutboxRecord[]
  broadcasts             Broadcast[]
  broadcastRecipients    BroadcastRecipient[]
  mediaAssets            MediaAsset[]
  scheduledMessages      ScheduledMessage[]
  telegramMediaGroups    TelegramMediaGroup[]
  telegramBotInterface   TelegramBotInterface?
  messageStatusEvents    MessageStatusEvent[]
  whatsAppTemplates      WhatsAppMessageTemplate[]

  @@unique([projectId, id])
  @@unique([type, providerIdentityId])
  @@index([projectId, status])
  @@index([projectId, type])
  @@index([type, providerAccountId, status])
  @@map("channel_connections")
}

model RawWebhookEvent {
  id               String                @id @default(uuid())
  projectId        String
  connectionId     String
  externalUpdateId String
  status           RawWebhookEventStatus @default(RECEIVED)
  payload          Json
  correlationId    String
  receivedAt       DateTime              @default(now()) @db.Timestamptz(3)
  purgeAfter       DateTime              @db.Timestamptz(3)
  connection       ChannelConnection     @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  inboxRecord      InboxRecord?

  @@unique([projectId, id])
  @@unique([connectionId, externalUpdateId])
  @@index([projectId, connectionId, receivedAt])
  @@index([projectId, correlationId])
  @@index([projectId, purgeAfter])
  @@map("raw_webhook_events")
}

model InboxRecord {
  id                String            @id @default(uuid())
  projectId         String
  connectionId      String
  rawWebhookEventId String            @unique
  status            InboxRecordStatus @default(PENDING)
  attempts          Int               @default(0)
  maxAttempts       Int               @default(8)
  nextAttemptAt     DateTime?         @db.Timestamptz(3)
  lockedAt          DateTime?         @db.Timestamptz(3)
  lockedBy          String?
  lastError         String?
  completedAt       DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  connection        ChannelConnection @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  rawWebhookEvent   RawWebhookEvent   @relation(fields: [projectId, rawWebhookEventId], references: [projectId, id], onDelete: Restrict)
  normalizedEvent   NormalizedEvent?

  @@unique([projectId, id])
  @@unique([projectId, rawWebhookEventId])
  @@index([status, nextAttemptAt])
  @@index([projectId, connectionId, status])
  @@map("inbox_records")
}

model NormalizedEvent {
  id                 String              @id @default(uuid())
  projectId          String
  connectionId       String
  inboxRecordId      String              @unique
  type               NormalizedEventType
  payload            Json
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  connection         ChannelConnection   @relation(fields: [projectId, connectionId], references: [projectId, id], onDelete: Restrict)
  inboxRecord        InboxRecord         @relation(fields: [projectId, inboxRecordId], references: [projectId, id], onDelete: Restrict)
  message            Message?
  messageStatusEvent MessageStatusEvent?
  scenarioExecutions ScenarioExecution[]
  crmOperations      CrmOperation[]

  @@unique([projectId, id])
  @@unique([projectId, inboxRecordId])
  @@index([projectId, connectionId, createdAt])
  @@map("normalized_events")
}

model Scenario {
  id              String              @id @default(uuid())
  projectId       String
  name            String
  description     String?
  status          ScenarioStatus      @default(DRAFT)
  activeVersionId String?
  draftVersionId  String?
  createdById     String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions        ScenarioVersion[]   @relation("ScenarioVersions")
  activeVersion   ScenarioVersion?    @relation("ScenarioActiveVersion", fields: [projectId, id, activeVersionId], references: [projectId, scenarioId, id], onDelete: Restrict)
  draftVersion    ScenarioVersion?    @relation("ScenarioDraftVersion", fields: [projectId, id, draftVersionId], references: [projectId, scenarioId, id], onDelete: Restrict)
  executions      ScenarioExecution[]
  waitStates      WaitState[]
  delayedActions  DelayedAction[]

  @@unique([projectId, id])
  @@unique([projectId, id, activeVersionId])
  @@unique([projectId, id, draftVersionId])
  @@index([projectId, status])
  @@index([projectId, updatedAt])
  @@map("scenarios")
}

model ScenarioVersion {
  id                 String                @id @default(uuid())
  projectId          String
  scenarioId         String
  version            Int
  status             ScenarioVersionStatus @default(DRAFT)
  graph              Json
  variablesSchema    Json                  @default("{}")
  compiledDefinition Json?
  validation         Json                  @default("{}")
  contentHash        String
  createdById        String?
