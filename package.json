{
  "name": "omnicus",
  "version": "0.1.0",
  "private": true,
  "description": "Omnicus omnichannel automation platform monorepo",
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.5.0"
  },
  "scripts": {
    "audit:production": "node scripts/pnpm.mjs audit --prod --audit-level=high",
    "build": "node scripts/pnpm.mjs db:generate && node scripts/turbo.mjs run build && node scripts/check-web-bundle.mjs && node scripts/prepare-runtime.mjs all",
    "build:api": "node scripts/pnpm.mjs db:generate && node scripts/turbo.mjs run build --filter=@omnicus/api... && node scripts/prepare-runtime.mjs api",
    "build:web": "node scripts/turbo.mjs run build --filter=@omnicus/web... && node scripts/check-web-bundle.mjs && node scripts/prepare-runtime.mjs web",
    "build:worker": "node scripts/turbo.mjs run build --filter=@omnicus/worker... && node scripts/prepare-runtime.mjs worker",
    "clean": "node scripts/turbo.mjs run clean",
    "contact-merge-backfill": "node scripts/pnpm.mjs --filter @omnicus/worker contact-merge-backfill",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "db:format": "node scripts/run-prisma.mjs format --schema prisma/schema.prisma",
    "db:generate": "node scripts/run-prisma.mjs generate --config prisma.config.ts",
    "db:bootstrap:admin": "node scripts/pnpm.mjs --filter @omnicus/database db:bootstrap:admin",
    "db:diff:check": "node scripts/check-prisma-sql.mjs",
    "db:migrate:dev": "node scripts/run-prisma.mjs migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "node scripts/run-prisma.mjs migrate deploy --config prisma.config.ts",
    "db:seed": "node scripts/pnpm.mjs --filter @omnicus/database db:seed",
    "db:sync-system-roles": "node scripts/pnpm.mjs --filter @omnicus/database db:sync-system-roles",
    "db:validate": "node scripts/run-prisma.mjs validate --config prisma.config.ts",
    "dev": "node scripts/pnpm.mjs db:generate && node scripts/turbo.mjs run dev",
    "dev:api": "node scripts/pnpm.mjs db:generate && node scripts/turbo.mjs run dev --filter=@omnicus/api...",
    "dev:web": "node scripts/turbo.mjs run dev --filter=@omnicus/web...",
    "dev:worker": "node scripts/turbo.mjs run dev --filter=@omnicus/worker...",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preflight": "node scripts/preflight.mjs",
    "preinstall": "node scripts/preflight.mjs",
    "runtime:check": "node scripts/prepare-runtime.mjs all",
    "start:api": "node scripts/pnpm.mjs --filter @omnicus/api start",
    "start:web": "node scripts/pnpm.mjs --filter @omnicus/web start",
    "start:worker": "node scripts/pnpm.mjs --filter @omnicus/worker start",
    "test": "node scripts/turbo.mjs run test test:integration",
    "test:api:production": "node scripts/pnpm.mjs build:api && node scripts/api-production-smoke.mjs",
    "test:e2e": "node scripts/pnpm.mjs build:web && playwright test",
    "test:worker:production": "node scripts/pnpm.mjs build:worker && node scripts/worker-production-smoke.mjs",
    "test:web:production": "node scripts/pnpm.mjs build:web && node scripts/pnpm.mjs --filter @omnicus/web test:production",
    "typecheck": "node scripts/pnpm.mjs db:generate && tsc -p tsconfig.json && node scripts/turbo.mjs run typecheck",
    "versions": "node scripts/versions.mjs"
  },
  "pnpm": {
    "overrides": {
      "find-my-way": "9.7.0",
      "js-yaml": "5.2.2",
      "valibot": "1.4.2",
      "fast-uri": "3.1.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsx": "4.23.1",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
